# Database Configuration
DATABASE_URL=postgresql://campusos_user:secure_password@localhost:5432/campusos_db
DATABASE_ECHO=False

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth2 Configuration
OAUTH2_PROVIDER=google  # google, microsoft, github
OAUTH2_CLIENT_ID=your-client-id
OAUTH2_CLIENT_SECRET=your-client-secret
OAUTH2_REDIRECT_URL=http://localhost:3000/auth/callback

# Ollama Configuration (Local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2  # or mistral, neural-chat, etc.
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@campusos.edu
SMTP_FROM_NAME=CampusOS

# Application Settings
APP_NAME=CampusOS
APP_VERSION=1.0.0
DEBUG=True
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# File Upload
MAX_UPLOAD_SIZE=52428800  # 50MB in bytes
ALLOWED_UPLOAD_TYPES=["pdf", "docx", "doc", "xlsx", "xls", "jpg", "jpeg", "png"]
UPLOAD_DIR=./uploads

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/campusos.log

# Monitoring
PROMETHEUS_ENABLED=True
PROMETHEUS_PORT=8001

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=3600  # 1 hour in seconds
